# --- App ---
ENV=prod
APP_NAME=EmployeeAttendance
APP_TZ=Asia/Kolkata
SECRET_KEY=29b2fbc68296ab8654ba0b0cd4199e7261ef550c771a73e09d2ff304acbd2402
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TRUSTED_HOSTS=euroatend.eurosolservice.com,localhost
SENTRY_DSN=

# --- DB: use sqlite for dev, postgres for prod/docker ---
# sqlite:
DATABASE_URL=sqlite:///./dev.db
# postgres example:
# DATABASE_URL=postgresql+psycopg2://attend:attend@db:5432/attend

# --- Seed admin ---
ADMIN_NAME=Administrator
ADMIN_MOBILE=9834460139
ADMIN_PASSWORD=Amar.Eurosol@2026

# --- Shift / policy (10am - 7pm) ---
SHIFT_START=10:00
SHIFT_END=19:00
LATE_AFTER_MINUTES=15
HALF_DAY_HOURS=4.0
MIN_SHIFT_HOURS=8.0
MAX_BREAK_MINUTES=45
MAX_GPS_ACCURACY_M=200
OVERTIME_ALLOWED=true
OVERTIME_LIMIT_HOURS=3.0
LUNCH_REMINDER_AT=13:00
AUTO_PUNCHOUT_ENABLED=true

# --- Geofence (office). Warn+flag mode ---
GEOFENCE_LAT=28.6139
GEOFENCE_LNG=77.2090
GEOFENCE_RADIUS_M=500
STRICT_GEOFENCE=false
STRICT_MOCK_BLOCK=false

# --- Tracking ---
TRACK_INTERVAL_SEC=90
TRACK_MIN_DISTANCE_M=50

# --- Storage: local | s3 ---
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# S3 (future): S3_BUCKET=, S3_REGION=, AWS_ACCESS_KEY_ID=, AWS_SECRET_ACCESS_KEY=

# --- CORS ---
CORS_ORIGINS=https://euroatend.eurosolservice.com,http://localhost:3000,http://localhost:8080
